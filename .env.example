# MongoDB Connection String (Optional - falls back to persistent local storage if empty)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/peerapply?retryWrites=true&w=majority

# Gemini API Key for AI flyer OCR & smart parsing (Optional - has built-in smart heuristic fallback)
GEMINI_API_KEY=your_gemini_api_key_here
